rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'admin' || 
        request.auth.token.role == 'admin' ||
        request.auth.token.email.matches('.*admin@easytrip\\.in')
      );
    }

    function isDriver() {
      return isAuthenticated() && (
        getUserData().role == 'driver' || 
        request.auth.token.role == 'driver'
      );
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. Drivers collection
    match /drivers/{driverId} {
      allow read: if true; // Public for ride searching & customer ETA tracking
      allow create: if isAuthenticated();
      allow update: if (isAuthenticated() && (resource.data.userId == request.auth.uid || isOwner(driverId))) || isAdmin();
      allow delete: if isAdmin();
    }

    // 3. Vehicles collection
    match /vehicles/{vehicleId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() || isAdmin();
      allow delete: if isAdmin();
    }

    // 4. Rides collection
    match /rides/{rideId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        isDriver() || // For drivers searching incoming requests
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        (isDriver() && resource.data.status == 'searching') || // Driver accepting ride
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // 5. Payments collection
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 6. Ratings collection
    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // 7. Complaints collection
    match /complaints/{complaintId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // 8. Coupons collection
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 9. Platform Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
